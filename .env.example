# NVIDIA_NIM_API_KEY: Required for AI celestial-object analysis, via NVIDIA NIM's free-tier
# vision model (meta/llama-3.2-11b-vision-instruct). Get a free key at https://build.nvidia.com/
# (sign in, open any model, click "Get API Key"). Starts with "nvapi-".
NVIDIA_NIM_API_KEY="nvapi-YOUR_KEY_HERE"

# APP_SECRET_TOKEN: Token to validate requests from the app to the server.
# IMPORTANT: generate a real random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT ship the placeholder below — it is a public default and provides no security.
APP_SECRET_TOKEN="CHANGE_ME_GENERATE_A_RANDOM_TOKEN"

# VITE_API_URL: Backend server URL (used by frontend)
VITE_API_URL="http://localhost:3001"

# VITE_APP_TOKEN: Must match APP_SECRET_TOKEN on the server
VITE_APP_TOKEN="CHANGE_ME_GENERATE_A_RANDOM_TOKEN"

# NASA_API_KEY: Optional - for Astronomy Picture of the Day
# Get a free key at https://api.nasa.gov/
NASA_API_KEY="DEMO_KEY"

# The one-time ₹199 ad-free unlock is handled entirely by Google Play Billing
# (see src/services/monetization.ts) — no server-side payment config needed. You just need
# to create a matching in-app product in Play Console: Monetize > Products > In-app products,
# product ID "nakshatra_ad_free_unlock", one-time, non-consumable, priced at ₹199.

# --- AdMob (optional in dev — falls back to Google's official test ad unit IDs) ---
# Real IDs from https://apps.admob.com/. Required before a production release: the test IDs
# above will never generate real revenue and Google will flag production traffic on test units.
VITE_ADMOB_BANNER_ID="ca-app-pub-3940256099942544/6300978111"
VITE_ADMOB_INTERSTITIAL_ID="ca-app-pub-3940256099942544/1033173712"
# Comma-separated AdMob test device IDs (from logcat on first run) — dev-only, never set in production.
VITE_ADMOB_TEST_DEVICE_IDS=""
